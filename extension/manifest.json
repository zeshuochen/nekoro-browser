{
  "manifest_version": 3,
  "name": "nekoro-browser",
  "version": "0.1.0",
  "description": "nekoro-browser — HTTP polling bridge to daemon (chrome.debugger API)",
  "permissions": [
    "alarms",
    "debugger",
    "tabs",
    "scripting"
  ],
  "host_permissions": [
    "http://127.0.0.1/*",
    "https://*/*",
    "http://*/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "icons": {
    "16": "icons/icon-16.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "minimum_chrome_version": "120",
  "key": ""
}
