# Python
__pycache__/
*.py[cod]
*.egg-info/
dist/
build/
*.egg

# Virtual environments
.venv/
venv/
# 库不锁依赖版本（本来就零依赖），锁文件只是本地噪音
# 注意：gitignore 不支持行尾注释，注释必须独占一行，否则整行都会被当成 pattern
uv.lock

# IDE
.vscode/
.idea/

# OS
.DS_Store
Thumbs.db

# Local automation scripts (do not commit)
scripts/*.ps1
scripts/*.py
scripts/*.sh
scripts/*.txt
!scripts/.gitkeep
